# Supabase Configuration
# Copy this file to .env.local and update with your Supabase project credentials

# Next.js Standard Format
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application URL (Set this to your production Vercel domain e.g. https://your-project.vercel.app in Vercel environment variables)
# Defaults to window.location.origin / http://localhost:3000 during local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vite Compatible Format (Optional)
VITE_SUPABASE_URL=your-project-id
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
